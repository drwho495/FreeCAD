@@ -610,6 +610,33 @@ cc_glglue_getprocaddress(const cc_glglue * glue, const char * symname)
 {
   void * ptr = NULL;
 
+#ifdef __EMSCRIPTEN__
+  // On WebAssembly there is no WGL/EGL/GLX/dlsym; resolve GL entry points
+  // (both emscripten's real WebGL2 functions and our fixed-function emulation
+  // in Gui/WasmGLFixedFunc.cpp) through emscripten's own resolver.
+  {
+    /* This file is compiled as C; these are C-linkage symbols.
+       Resolve through our fixed-function emulator (Gui/WasmGLFixedFunc.cpp)
+       FIRST: functions like glDrawArrays/glDrawElements/glVertexPointer exist in
+       emscripten too, but Coin uses them in fixed-function mode which the raw
+       WebGL2 entry points do not implement. Taking ours first routes Coin into
+       the emulator (and keeps those symbols alive against DCE). Modern WebGL2
+       functions (buffers, textures, glActiveTexture, ...) are NOT in our table,
+       so they fall through to emscripten's, which does the GL-name<->WebGLObject
+       handle translation. */
+    {
+      extern void * fcWasmResolveGL(const char *);
+      ptr = fcWasmResolveGL(symname);
+      if (ptr) goto returnpoint;
+    }
+    {
+      extern void * emscripten_GetProcAddress(const char *);
+      ptr = emscripten_GetProcAddress(symname);
+      if (ptr) goto returnpoint;
+    }
+  }
+#endif
+
   // FIXME: also supply 'glue' to coin_[x]gl_getprocaddress()
   ptr = coin_wgl_getprocaddress(glue, symname);
   if (ptr) goto returnpoint;
@@ -704,8 +731,19 @@ glglue_set_glVersion(cc_glglue * w)
   w->version.minor = 0;
   w->version.release = 0;
 
+  if (!w->versionstr) { return; }
   (void)strncpy(buffer, (const char *)w->versionstr, 255);
   buffer[255] = '\0'; /* strncpy() will not null-terminate if strlen > 255 */
+  {
+    /* OpenGL ES / WebGL report GL_VERSION like "OpenGL ES 3.0 (WebGL 2.0 ...)".
+       The default parser does atoi() from the start and gets 0, so no version-
+       gated entry points are ever resolved. Advance to the first digit so the
+       real "3.0" is parsed (WebGL2 == GLES3, which for Coin's feature gates is
+       treated as a very capable desktop GL). */
+    char * d = buffer;
+    while (*d && (*d < '0' || *d > '9')) { d++; }
+    if (d != buffer) { memmove(buffer, d, strlen(d) + 1); }
+  }
   dotptr = strchr(buffer, '.');
   if (dotptr) {
     char * spaceptr;
@@ -1386,6 +1424,20 @@ glglue_resolve_symbols(cc_glglue * w)
 #endif /* GL_ARB_vertex_buffer_object */
 
   if (w->glBindBuffer) {
+#ifdef __EMSCRIPTEN__
+    /* WebGL2 has no glMapBuffer/glUnmapBuffer/glGetBufferSubData/glGetBufferParameteriv/
+       glGetBufferPointerv, but Coin's SoVBO only ever uses glGenBuffers/glBindBuffer/
+       glBufferData/glDeleteBuffers (upload via glBufferData; verified no glMapBuffer call
+       in the render path). Require only the core set so VBOs stay enabled — static
+       geometry is uploaded once instead of re-uploaded every frame as a client array. */
+    if (!w->glDeleteBuffers ||
+        !w->glGenBuffers ||
+        !w->glIsBuffer ||
+        !w->glBufferData ||
+        !w->glBufferSubData) {
+      w->glBindBuffer = NULL;
+    }
+#else
     if (!w->glDeleteBuffers ||
         !w->glGenBuffers ||
         !w->glIsBuffer ||
@@ -1403,6 +1455,7 @@ glglue_resolve_symbols(cc_glglue * w)
                                   "vertex buffer object functions were not found");
       }
     }
+#endif
   }
 
   /* GL_NV_register_combiners */
@@ -2958,6 +3011,12 @@ void
 cc_glglue_glActiveTexture(const cc_glglue * w,
                           GLenum texture)
 {
+#ifdef __EMSCRIPTEN__
+  /* On wasm the glue may have been probed before a GL context was current, so
+     multitexture entry points can be unset. Tolerate that instead of calling
